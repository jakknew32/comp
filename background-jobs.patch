+def test_job_upload_flow_without_conversion(client: TestClient) -> None:
+    start = client.post(
+        "/api/jobs/pages",
+        files=[
+            ("files", ("a.png", png_bytes(fixtures.synthetic_lineart()), "image/png")),
+            ("files", ("b.png", png_bytes(fixtures.synthetic_lineart()), "image/png")),
